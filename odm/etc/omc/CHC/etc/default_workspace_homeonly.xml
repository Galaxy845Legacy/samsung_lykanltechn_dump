<favorites xmlns:launcher="http://schemas.android.com/apk/res/com.sec.android.app.launcher">
    <homeGridInfo default="4x4"/>
    <home>
	
        <!-- Hidden App -->
        <!-- S reminder -->
        <favorite        
            launcher:packageName="com.samsung.android.app.sreminder"
            launcher:className="com.samsung.android.app.sreminder.phone.cardlist.SReminderActivity"
            launcher:hidden="true" 
            launcher:screen="-1" />
			
        <!-- appwidget : Weather -->
        <appwidget 
            screen="0" 
            packageName="com.sec.android.daemonapp" 
            className="com.sec.android.daemonapp.appwidget.WeatherAppWidget2x1" 
            x="1" 
            y="0" 
            spanX="2" 
            spanY="3" />

        <!-- appwidget : Search -->
        <appwidget
            screen="0"
            packageName="com.samsung.android.app.searchwidget"
            className="com.samsung.android.app.searchwidget.ui.SearchWidget"
            x="0" 
            y="3"
            spanX="4"
            spanY="1" />

        <!-- folder : Samsung -->
        <folder 
            screen="1" 
            title="Samsung" 
            x="0" 
            y="0">
            <!-- Samsung Connect -->
            <favorite 
                screen="0" 
                packageName="com.samsung.android.oneconnect" 
                className="com.samsung.android.oneconnect.ui.SCMainActivity" />
            <!-- Voice Recorder -->
            <favorite 
                screen="1" 
                packageName="com.sec.android.app.voicenote" 
                className="com.sec.android.app.voicenote.main.VNMainActivity" />
            <!-- Email -->
            <favorite 
                screen="2" 
                packageName="com.samsung.android.email.provider" 
                className="com.samsung.android.email.ui.activity.MessageListXL" />
            <!-- My Files -->
            <favorite 
                screen="3" 
                packageName="com.sec.android.app.myfiles" 
                className="com.sec.android.app.myfiles.common.MainActivity" />
            <!-- Samsung Health -->
            <favorite 
                screen="4" 
                packageName="com.sec.android.app.shealth" 
                className="com.samsung.android.app.shealth.home.HomeMainActivity" />
            <!-- Samsung Members -->
            <favorite 
                screen="5" 
                packageName="com.samsung.android.voc" 
                className="com.samsung.android.voc.LauncherActivity" />
            <!-- Samsung Data Store -->
            <favorite 
                screen="6" 
                packageName="com.samsung.android.globalroaming" 
                className="com.samsung.android.globalroaming.activity.StartingActivity" />
            <!-- Hancom Office Editor -->
            <favorite 
                screen="7" 
                packageName="com.hancom.office.editor" 
                className="com.tf.thinkdroid.manager.EditorStartActivity" />
            <!-- Search -->
            <favorite 
                screen="8" 
                packageName="com.samsung.android.app.searchwidget" 
                className="com.samsung.android.app.searchwidget.ui.FeedsActivity" />
        </folder>

        <!-- Samsung Pay -->
        <favorite 
            screen="1" 
            packageName="com.samsung.android.spay" 
            className="com.samsung.android.spay.ui.SpayMainActivity" 
            x="1" 
            y="0" />

        <!-- Galaxy Apps -->
        <favorite 
            screen="1" 
            packageName="com.sec.android.app.samsungapps" 
            className="com.sec.android.app.samsungapps.SamsungAppsMainActivity" 
            x="2" 
            y="0" />

        <!-- Gallery -->
        <favorite 
            screen="1" 
            packageName="com.sec.android.gallery3d" 
            className="com.sec.android.gallery3d.app.GalleryOpaqueActivity" 
            x="3" 
            y="0" />

