        <favorite 
            screen="1" 
            packageName="com.sec.android.app.clockpackage" 
            className="com.sec.android.app.clockpackage.ClockPackage" 
            x="0" 
            y="1" />
			
		<!-- Contacts -->
        <favorite 
            screen="1" 
            packageName="com.samsung.android.contacts" 
            className="com.android.contacts.activities.PeopleActivity" 
            x="1" 
            y="1" />

        <!-- Settings -->
        <favorite 
            screen="1" 
            packageName="com.android.settings" 
            className="com.android.settings.Settings" 
            x="2" 
            y="1" />

        <!-- Calendar -->
        <favorite 
            screen="1" 
            packageName="com.samsung.android.calendar" 
            className="com.android.calendar.AllInOneActivity" 
            x="3" 
            y="1" />

        <!-- Calculator -->
        <favorite 
            screen="1" 
            packageName="com.sec.android.app.popupcalculator" 
            className="com.sec.android.app.popupcalculator.Calculator" 
            x="0" 
            y="2" />

        <!-- Samsung Music -->
        <favorite 
            screen="1" 
            packageName="com.sec.android.app.music" 
            className="com.sec.android.app.music.common.activity.MusicMainActivity" 
            x="1" 
            y="2" />

        <!-- Samsung Video -->
        <favorite 
            screen="1" 
            packageName="com.samsung.android.videolist" 
            className="com.samsung.android.videolist.list.activity.VideoList" 
            x="2" 
            y="2" />

        <!-- Samsung Notes -->
        <favorite 
            screen="1" 
            packageName="com.samsung.android.app.notes" 
            className="com.samsung.android.app.notes.memolist.MemoListActivity" 
            x="3" 
            y="2" />
			
        <!-- Samsung Theme -->
        <favorite 
            screen="1" 
            packageName="com.samsung.android.themestore" 
            className="com.samsung.android.themestore.activity.Launcher" 
			x="0" 
            y="3"/>

        <!-- Smart Manager -->
        <favorite 
            screen="1" 
            packageName="com.samsung.android.sm_cn" 
            className="com.samsung.android.sm.ui.cstyleboard.SmartManagerDashBoardActivity" 
            x="1" 
            y="3" />

	    <!-- XinXiTianXia -->
	    <favorite 
            screen="1" 
            packageName="com.linkage.ctheartworld" 
            className="com.linkage.ctheartworld.activity.IndexActivity" 
            x="2" 
            y="3" />

        <!-- CT Client-->
        <favorite
	        screen="1" 
            packageName="com.ct.client" 
            className="com.ct.client.SplashActivity" 
            x="3" 
            y="3" />
 
    </home>


    <hotseat>
        <!-- Phone -->
        <favorite 
            screen="0" 
            packageName="com.samsung.android.contacts" 
            className="com.android.dialer.DialtactsActivity" />

        <!-- Messages -->
        <favorite 
            screen="1" 
            packageName="com.samsung.android.messaging" 
            className="com.android.mms.ui.ConversationComposer" />

        <!-- Samsung Internet -->
        <favorite 
            screen="2" 
            packageName="com.sec.android.app.sbrowser" 
            className="com.sec.android.app.sbrowser.SBrowserMainActivity" />

        <!-- Camera -->
        <favorite 
            screen="3" 
            packageName="com.sec.android.app.camera" 
            className="com.sec.android.app.camera.Camera" />

    </hotseat>

</favorites>
